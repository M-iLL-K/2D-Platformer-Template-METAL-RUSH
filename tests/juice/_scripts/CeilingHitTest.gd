extends Node2D

# 手動驗證用：Juice 的「撞天花板時」。中間有一段低天花板，螢幕震動、粒子、音效（嗶）都選「撞天花板時」。
# 玩家掛了重力翻轉卡（Shift），翻過來之後「天花板」跟著翻。

var _count := 0

# 接上玩家的撞天花板訊號，印出操作說明
func _ready() -> void:
	$Player.ceiling_hit.connect(_on_ceiling_hit)
	print("[測試] ① 走到中間的低天花板底下跳：頭撞到天花板的那一下，畫面震動、冒粒子、嗶一聲，輸出面板印「撞天花板」")
	print("[測試] ② 貼著天花板不放跳躍鍵、左右移動：不會一直觸發（只有剛撞到的那一下）")
	print("[測試] ③ 在空地跳、落地、撞牆：都不會觸發")
	print("[測試] ④ 站在天花板底下按 Shift 翻轉重力：黏到天花板上是「落地」不觸發；翻過來之後往下（新的上方）跳撞到地板才觸發")
	print("[測試] ⑤ 編輯器裡選任一個 Juice，timing 下拉「撞牆時」後面多了「撞天花板時」；其他 Juice 原本選的選項沒有變")

# 玩家撞到天花板時印出次數
func _on_ceiling_hit() -> void:
	_count += 1
	print("[測試] 撞天花板（第 %d 次）" % _count)
