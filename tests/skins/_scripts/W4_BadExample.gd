extends Node2D

# 教學用壞範例：跟 levels/_starts/W4_SkinBox.tscn 同一條路線，故意做壞，用來並排截圖做簡報的對比。
# 壞在哪：素材混搭（三種畫風的金幣、別套素材的尖刺、AI 圖的終點）、縮放不是整數倍、有的圖糊掉（Linear）、
# 背景是很亮的黃色格子（比主角搶眼）、HUD 用了四種字型和四種顏色、位置東一個西一個沒對齊。
# 不進學員壓縮檔（tests/ 是 export-ignore），也不進煙霧測試（它本來就該有很多黃色驚嘆號）。

# 印出這個場景是做什麼的
func _ready() -> void:
	print("[測試] 壞範例：跟 W4_SkinBox 同一條路線，並排截圖做對比")
	print("[測試] ① 金幣三種畫風、大小不一，有的糊掉；尖刺是別套素材、糊的；終點是另一種畫風")
	print("[測試] ② 背景是很亮的黃色，比主角還搶眼")
	print("[測試] ③ HUD 用了四種字型、四種顏色，位置沒對齊，正中間還有一行大標題擋視線")
	print("[測試] ④ 編輯器裡：很多 Skin 有畫面風格的黃色驚嘆號（U193），正好拿來示範那些提醒在說什麼")
	print("[測試] ⑤ 拖一個 skins/SquintTest 進來按 F1：主角在亮黃背景上幾乎看不出來")
